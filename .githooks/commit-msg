#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Zoree TMS — commit-msg guard
#
# The repo's history hit 20+ consecutive "bug fixes" subjects, which makes
# `git log --grep`, `git blame`, and `git bisect` basically useless when
# tracking down regressions. This hook nudges every commit toward a
# scope-prefixed, specific subject line.
#
# What it rejects:
#   * Empty / whitespace-only subjects
#   * Subjects that are exactly one of {bug fix, fix, wip, misc, update, ...}
#   * Subjects under 12 characters
#
# What it allows:
#   * Anything generated by git (Merge / Revert / fixup! / squash! / amend!)
#   * Anything else, including non-conventional formats — we're not enforcing
#     conventional-commits, just blocking the obviously low-signal cases.
#
# Bypass with `git commit --no-verify` if you really must.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

MSG_FILE=$1
# Pull the first non-blank, non-comment line — that's the subject.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | awk 'NF{print; exit}')

# Trim leading/trailing whitespace.
SUBJECT="${SUBJECT#"${SUBJECT%%[![:space:]]*}"}"
SUBJECT="${SUBJECT%"${SUBJECT##*[![:space:]]}"}"

# Auto-generated messages — let them through unchanged.
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

if [ -t 2 ] && command -v tput >/dev/null 2>&1; then
  RED=$(tput setaf 1); RESET=$(tput sgr0)
else
  RED=''; RESET=''
fi

reject() {
  printf '%s✗ commit-msg blocked:%s %s\n' "$RED" "$RESET" "$1" >&2
  printf '   Subject: %s\n' "${SUBJECT:-<empty>}" >&2
  printf '   Use a scope-prefixed, specific message. Examples:\n' >&2
  printf '     oms-inventory: backfill from items table\n' >&2
  printf '     api/invoices: fix duplicate cost-line write\n' >&2
  printf '     hooks: add commit-msg guard\n' >&2
  printf '   Bypass with --no-verify if you really must.\n' >&2
  exit 1
}

shopt -s nocasematch
case "$SUBJECT" in
  '')
    reject "empty subject line" ;;
  bug\ fix|bug\ fixes|bugfix|bugfixes)
    reject "'bug fixes' is too vague — say what bug, in what area" ;;
  fix|fixes|fixed)
    reject "'$SUBJECT' is too vague — fix what?" ;;
  wip|tmp|temp|misc|stuff|update|updates|change|changes|tweak|tweaks)
    reject "'$SUBJECT' is too vague to be useful in git log" ;;
esac
shopt -u nocasematch

if [ "${#SUBJECT}" -lt 12 ]; then
  reject "subject too short (${#SUBJECT} chars, need 12+)"
fi

exit 0
