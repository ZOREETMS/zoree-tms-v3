# zoree-mcp settings — copy to .env (gitignored) and fill in.

# ZoreeTMS Express API this server reads from (no trailing slash)
ZOREE_API_URL=http://localhost:3010

# Public HTTPS origin of THIS server (the OAuth issuer Claude sees).
# Leave unset locally; start-with-tunnel.ps1 sets it automatically.
# PUBLIC_URL=https://mcp.zoree.io

# Listen port
PORT=3030

# OAuth callback hosts allowed to register (loopback always allowed)
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com

# 32+ random chars. Seals OAuth client ids + auth codes. Rotating it
# signs every connected Claude user out. Generate: openssl rand -hex 32
MCP_SECRET=
