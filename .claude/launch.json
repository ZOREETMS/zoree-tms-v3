{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3001,
      "cwd": "api",
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/serve/build/main.js", "frontend", "-l", "3000"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
