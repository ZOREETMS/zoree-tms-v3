# ── Server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Tender emails (optional) ────────────────────────────────────────
# 1) Copy this file to .env in the same folder (api/.env is gitignored).
# 2) Set SMTP_HOST, SMTP_USER, SMTP_PASS (and usually SMTP_FROM).
# 3) Run npm start in api/; in the UI, set carrier Email, log in, tender a shipment.
# Without SMTP_HOST, tender still saves; API only logs a draft.
#
# Office 365 often: SMTP_HOST=smtp.office365.com  PORT=587  SMTP_SECURE=false
# Gmail/Google: use an App Password; may use smtp.gmail.com
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=contact@zoree.io
# SMTP_REPLY_TO=ops@yourcompany.com
# TENDER_EMAIL_OVERRIDE=you@yourcompany.com
# SMTP_DEBUG=true
#
# After restart, verify: curl http://localhost:3001/health
# → tenderEmail.smtpConfigured and tenderEmail.verifyOk show whether mail can send.

# ── SMC3 CzarLite / CarrierConnect XL ────────────────────────────
# WO 465640 — get credentials from SMC3 portal
SMC3_TARIFF=DEMOLTLA
SMC3_LICENSE_KEY=
SMC3_CCXL_KEY=
SMC3_USERNAME=
SMC3_PASSWORD=

# ── Microsoft Teams (optional — docs/TEAMS_SETUP.md) ───────────────
# Channel notification cards (tender sent/accepted/rejected).
# Create a Teams Workflow "Post to a channel when a webhook request is
# received" and paste its URL here. Without it, Teams notify is a no-op.
# TEAMS_WEBHOOK_URL=
# TEAMS_NOTIFY_ENABLED=true
# TEAMS_NOTIFY_ORDERS=false
# Base URL used in "Open in Zoree TMS" card buttons:
# ZOREE_WEB_URL=http://localhost:5173
#
# Interactive bot (plan/tender/accept from Teams chat).
# From the Azure Bot registration:
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_PASSWORD=
# Dedicated TMS user the bot acts as (create in Supabase Auth, planner role):
# TEAMS_BOT_TMS_EMAIL=
# TEAMS_BOT_TMS_PASSWORD=
# TEAMS_BOT_API_BASE=http://localhost:3001/api

# ── Multi-Tenancy ──────────────────────────────────────────────────
# Each tenant gets their own Supabase project in production.
# In dev, all tenants share one project with tenant_id scoping.
DEFAULT_TENANT=zoree-default
