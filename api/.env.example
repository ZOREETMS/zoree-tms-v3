SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── JWT Auth ───────────────────────────────────────────────────────
JWT_SECRET=zoree-tms-jwt-secret-change-in-production
JWT_EXPIRY=8h

# ── Server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Tender emails (optional) ────────────────────────────────────────
# 1) Copy this file to .env in the same folder (api/.env is gitignored).
# 2) Set SMTP_HOST, SMTP_USER, SMTP_PASS (and usually SMTP_FROM).
# 3) Run npm start in api/; in the UI, set carrier Email, log in, tender a shipment.
# Without SMTP_HOST, tender still saves; API only logs a draft.
#
# Office 365 often: SMTP_HOST=smtp.office365.com  PORT=587  SMTP_SECURE=false
# Gmail/Google: use an App Password; may use smtp.gmail.com
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=contact@zoree.io
# SMTP_REPLY_TO=ops@yourcompany.com
# TENDER_EMAIL_OVERRIDE=you@yourcompany.com
# SMTP_DEBUG=true
#
# After restart, verify: curl http://localhost:3001/health
# → tenderEmail.smtpConfigured and tenderEmail.verifyOk show whether mail can send.

# ── SMC3 CzarLite / CarrierConnect XL ────────────────────────────
# WO 465640 — get credentials from SMC3 portal
SMC3_TARIFF=DEMOLTLA
SMC3_LICENSE_KEY=
SMC3_CCXL_KEY=
SMC3_USERNAME=
SMC3_PASSWORD=

# ── Microsoft Teams (optional — docs/TEAMS_SETUP.md) ───────────────
# Channel notification cards (tender sent/accepted/rejected).
# Create a Teams Workflow "Post to a channel when a webhook request is
# received" and paste its URL here. Without it, Teams notify is a no-op.
# TEAMS_WEBHOOK_URL=
# TEAMS_NOTIFY_ENABLED=true
# TEAMS_NOTIFY_ORDERS=false
# Base URL used in "Open in Zoree TMS" card buttons:
# ZOREE_WEB_URL=http://localhost:5173
#
# Interactive bot (plan/tender/accept from Teams chat).
# From the Azure Bot registration:
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_PASSWORD=
# Dedicated TMS user the bot acts as (create in Supabase Auth, planner role):
# TEAMS_BOT_TMS_EMAIL=
# TEAMS_BOT_TMS_PASSWORD=
# TEAMS_BOT_API_BASE=http://localhost:3001/api

# ── Otodus Quantum optimization engine (vendor Docker container) ────
# Start the vendor's container yourself first (docker load + docker run
# per their manual, default port 8000), then point this at it.
# QUANTUM_ENGINE_URL=http://localhost:8000
# QUANTUM_ENGINE_API_KEY=

# ── Multi-Tenancy ──────────────────────────────────────────────────
# Each tenant gets their own Supabase project in production.
# In dev, all tenants share one project with tenant_id scoping.
DEFAULT_TENANT=zoree-default

# ── Jev (TypeSafe AI System One) — intent gate for the Teams bot ──
# services/ai/intentGate.js. Server-side only; never expose to the frontend.
# JEV_MODE: off | shadow (log only, default) | enforce (may veto a mutating
# command it is confident is a question). Decisions → api/jev-decisions.log
TYPESAFE_API_KEY=
JEV_MODE=shadow
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=1500
JEV_VETO_THRESHOLD=0.7

# ── Demo safety (see services/teamsBot/dryRun.js, services/ai/intentGate.js) ──
# TEAMS_BOT_DRY_RUN=true: Teams commands that change data reply "would …" and change nothing.
# JEV_FAIL_MODE (enforce only): open = Jev down → keyword result stands (today);
#   closed = Jev down → only a bare command like "plan ORD-1" may change data.
TEAMS_BOT_DRY_RUN=false
JEV_FAIL_MODE=open
# ── Email order agent (docs/EMAIL_ORDER_AGENT.md) ────────────────────
# Claude key for reading emails. Use a NEW key from console.anthropic.com
# (the old VITE_ANTHROPIC_API_KEY in frontend/.env is revoked).
ANTHROPIC_API_KEY=
EMAIL_INTAKE_ENABLED=false
EMAIL_INTAKE_IMAP_HOST=imap.gmail.com
EMAIL_INTAKE_IMAP_PORT=993
EMAIL_INTAKE_IMAP_USER=sridhar@zoree.io
# 16-character Google app password for sridhar@zoree.io (no spaces)
EMAIL_INTAKE_IMAP_PASS=
EMAIL_INTAKE_POLL_SECONDS=120
EMAIL_INTAKE_MAX_PER_POLL=10
# true = create orders without review when confidence >= min and nothing required is missing
EMAIL_INTAKE_AUTO_CREATE=false
EMAIL_INTAKE_AUTO_CREATE_MIN_CONFIDENCE=0.9
# Optional overrides:
# EMAIL_INTAKE_MODEL=claude-sonnet-5-5
# EMAIL_INTAKE_QUERY=label:zoree-orders newer_than:7d

# Quantum planning engine: zoree (in-process QUBO, default) | otodus (vendor container)
QUANTUM_ENGINE_MODE=zoree

# D-Wave (sampler: dwave-hybrid | dwave-qpu). Needs: pip install dwave-ocean-sdk
# Token from a Leap paid plan or Quantum LaunchPad trial (self sign-up trial has none)
DWAVE_API_TOKEN=
# DWAVE_PYTHON=C:\Python312\python.exe

# ── Carrier invoice PDF intake (migration 051) — optional, uses ANTHROPIC_API_KEY ──
# INVOICE_INTAKE_MODEL=claude-sonnet-5-5
# INVOICE_INTAKE_MIN_CONFIDENCE=0.85
# INVOICE_INTAKE_TIMEOUT_MS=90000
# EMAIL_INVOICE_INTAKE=true   # carrier-invoice emails → invoice PDF intake (set false to turn off)

# Freight Audit agent AP policy (see services/agents/freightAudit/apPolicy.js)
# AGENT_POLICY_APPROVE_INVOICE=auto
# FREIGHT_AUDIT_APPROVAL_LIMIT_USD=2500
# FREIGHT_AUDIT_ERP_READ_ONLY=true
# FREIGHT_AUDIT_FREEZE=11-20..01-05
# FREIGHT_AUDIT_SHADOW_MODE=auto

# Client domains (migration 052). off = no domain filtering (rollback switch).
DOMAIN_SCOPING=on

# Client domains: mail addressed to a domain's address is processed in that domain.
# EMAIL_INTAKE_DOMAIN_ADDRESSES=KESTREL_BAY=ap+kestrelbay@example.com

# Common AP mailbox for carrier invoices (optional second account).
# EMAIL_INTAKE_AP_IMAP_USER=ap@yourcompany.com
# EMAIL_INTAKE_AP_IMAP_PASS=            # 16-char Google app password for that account
# EMAIL_INTAKE_AP_AUTO=false            # false = read only when "Read AP Mailbox" is pressed

# Carrier invoices by email: verify the sender's domain against the carrier's
# billing email on file (+ SPF/DKIM/DMARC). Unverified senders are still audited
# but never auto-approved. on (default) | off
# EMAIL_INVOICE_SENDER_CHECK=on
