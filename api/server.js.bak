riffName:tn||T,shipmentDateCCYYMMDD:ymd(),originPostalCode:o,originCountry:'USA',destinationPostalCode:d,destinationCountry:'USA',commodities:cm||[{freightClass:String(fc||85),weight:Math.round(w||1000)}]},function(e,data){if(e)return r.status(502).json({error:e.message});var l=data.linehaulCharge||0,f=data.fuelSurcharge||0,a=data.accessorialCharge||0,t=data.totalCharge||data.totalAmount||(l+f+a),bw=data.billedWeight||w||1000;r.json({source:'smc3',tariff:tn||T,linehaul:Math.round(l),fuel:Math.round(f),acc:Math.round(a),total:Math.round(t),billedWeight:bw,ratePerCwt:bw>0?(l/(bw/100)).toFixed(2):'0',raw:data});});});console.log('SMC3 LIVE DEMOLTLA');})();
